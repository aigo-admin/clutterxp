{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RulesList",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "priority", "enabled", "destination"],
        "properties": {
          "name": {"type": "string"},
          "priority": {"type": "integer"},
          "enabled": {"type": "boolean"},
          "keywords": {
            "type": "array",
            "items": {"type": "string"}
          },
          "all_of": {
            "type": "array",
            "items": {"type": "string"}
          },
          "exclude": {
            "type": "array",
            "items": {"type": "string"}
          },
          "extensions": {
            "type": "array",
            "items": {"type": "string"}
          },
          "destination": {"type": "string"},
          "collision": {"type": "string"},
          "match": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
